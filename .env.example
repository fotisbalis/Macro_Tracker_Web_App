DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/macro_tracker
SESSION_COOKIE_SECURE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Macro Tracker <no-reply@example.com>

# Keep "mock" while developing without API charges. Change to "qwen" to use Qwen.
AI_PROVIDER=mock
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-flash
QWEN_TIMEOUT_SECONDS=30
